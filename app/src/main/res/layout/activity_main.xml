<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout android:orientation="vertical" android:padding="24dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="OTP Relay — forwards incoming SMS to Telegram and Supabase." />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Telegram bot token" />
        <EditText android:id="@+id/botToken" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="text" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingTop="12dp" android:text="Telegram chat id" />
        <EditText android:id="@+id/chatId" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="text" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingTop="12dp" android:text="Supabase URL" />
        <EditText android:id="@+id/supabaseUrl" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="textUri"
            android:text="https://pdnbxvglzrvifhvujikd.supabase.co" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingTop="12dp" android:text="Supabase service_role key" />
        <EditText android:id="@+id/supabaseKey" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="textPassword" />

        <!-- SIM filter -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingTop="16dp" android:text="Forward SMS from:" />

        <RadioGroup android:id="@+id/simGroup"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="4dp">
            <RadioButton android:id="@+id/simAll" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:text="All SIMs" android:checked="true" />
            <RadioButton android:id="@+id/simOne" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:text="SIM 1 only" />
            <RadioButton android:id="@+id/simTwo" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:text="SIM 2 only" />
        </RadioGroup>

        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="20dp">
            <Button android:id="@+id/saveBtn" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content" android:text="Save" />
            <Button android:id="@+id/testBtn" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content" android:text="Send test" />
        </LinearLayout>

        <Button android:id="@+id/defaultSmsBtn" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="Set as Default SMS App (100% reliable)" />

        <Button android:id="@+id/notifBtn" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="Grant Notification Access (backup method)" />

        <Button android:id="@+id/batteryBtn" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="Disable battery optimisation (tap once)" />

        <TextView android:id="@+id/statusText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="16dp" android:text="" />

        <TextView android:id="@+id/lastSmsText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="8dp"
            android:textColor="#888888" android:text="No SMS received yet" />

    </LinearLayout>
</ScrollView>
