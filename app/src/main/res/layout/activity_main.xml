<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="OTP Relay — forwards each incoming SMS to Telegram and Supabase." />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Telegram bot token" />
        <EditText android:id="@+id/botToken" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="text" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingTop="12dp" android:text="Telegram chat id" />
        <EditText android:id="@+id/chatId" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="text" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingTop="12dp" android:text="Supabase URL" />
        <EditText android:id="@+id/supabaseUrl" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="textUri"
            android:text="https://pdnbxvglzrvifhvujikd.supabase.co" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingTop="12dp" android:text="Supabase service_role key" />
        <EditText android:id="@+id/supabaseKey" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="textPassword" />

        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="20dp">
            <Button android:id="@+id/saveBtn" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content" android:text="Save" />
            <Button android:id="@+id/testBtn" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content" android:text="Send test" />
        </LinearLayout>

        <!-- Tap this once after install so Android never kills the app -->
        <Button android:id="@+id/batteryBtn" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="Disable battery optimisation (tap once)" />

        <TextView android:id="@+id/statusText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="16dp" android:text="" />

    </LinearLayout>
</ScrollView>
